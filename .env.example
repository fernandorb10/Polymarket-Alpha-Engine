AI_PROVIDER=gemini
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

DATABASE_PATH=./data/alpha_engine.db
REPORT_DIR=./reports
LOG_LEVEL=INFO
GAMMA_URL=https://gamma-api.polymarket.com
CLOB_URL=https://clob.polymarket.com
HTTP_TIMEOUT=30
SCAN_LIMIT=1000
ANALYSIS_TOP_N=3
ANALYSIS_COOLDOWN_MINUTES=180
MAX_AI_CALLS_PER_CYCLE=6

MIN_LIQUIDITY=5000
MIN_VOLUME=10000
MAX_SPREAD=0.08
MIN_PRICE=0.05
MAX_PRICE=0.95
MIN_HOURS_TO_CLOSE=6
MIN_NET_EDGE=0.06
MIN_CONFIDENCE=0.55
MAX_CRITIC_RISK=0.65

BANKROLL_USDC=1000
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.02
MAX_TOTAL_EXPOSURE_PCT=0.15
MAX_EVENT_EXPOSURE_PCT=0.05
MAX_CATEGORY_EXPOSURE_PCT=0.10
MAX_RELATED_POSITIONS=2

SLIPPAGE_BUFFER=0.01
PAPER_EXECUTION_SLIPPAGE_PCT=0.0025
PAPER_FEE_PCT=0.001

TAKE_PROFIT_PCT=0.15
STOP_LOSS_PCT=0.10
TRAILING_STOP_PCT=0.06
TRAILING_ACTIVATION_PCT=0.08
EXIT_MIN_EDGE=0.02
EXIT_CONFIRMATION_CYCLES=2
EXIT_HOURS_TO_RESOLUTION=24
MAX_POSITION_AGE_DAYS=180

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_REFRESH_SECONDS=30
STALE_CYCLE_MINUTES=30
