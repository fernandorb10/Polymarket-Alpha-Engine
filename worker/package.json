{
  "name": "el-rojilla-bot-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute alpha-engine --local --file=./schema/schema.sql",
    "db:migrate:remote": "wrangler d1 execute alpha-engine --remote --file=./schema/schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
